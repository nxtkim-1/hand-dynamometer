{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "gripcheck"
      }
    }
  ],
  "services": {
    "gripcheck": {
      "root": ".",
      "entrypoint": "webapp.py"
    }
  }
}
